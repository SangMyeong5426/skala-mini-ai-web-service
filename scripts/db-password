#!/bin/sh
# backend/.env 의 DATABASE_PASSWORD 만 안전하게 채운다.
#
# 편집기로 열지 않는다 — 저장을 깜빡하는 사고를 막는다.
# 입력은 화면에 보이지 않고, 셸 명령 기록에도 남지 않는다.

set -e
ENV_FILE="backend/.env"

[ -f "$ENV_FILE" ] || {
  printf '%s\n' "ERROR: $ENV_FILE 이 없습니다. cp backend/.env.example backend/.env" >&2
  exit 1; }

printf '%s\n' "Supabase 대시보드의 DB 비밀번호를 붙여넣고 Enter."
printf '%s\n' "화면에 보이지 않습니다. 모르면 Ctrl+C 로 나가서 Reset database password 를 누르세요."
printf '%s' "> "

# 입력을 감춘다
stty -echo 2>/dev/null || true
IFS= read -r PW
stty echo 2>/dev/null || true
printf '\n'

[ -n "$PW" ] || { printf '%s\n' "아무것도 입력하지 않았습니다. 취소합니다." >&2; exit 1; }

# 값에 어떤 문자가 있어도 안전하게 넣는다. sed 는 / 나 & 에서 깨진다.
PW="$PW" python3 - "$ENV_FILE" <<'PY'
import io, os, sys
path = sys.argv[1]
pw = os.environ['PW']
lines = io.open(path, encoding='utf-8').read().split('\n')
hit = False
for i, l in enumerate(lines):
    if l.startswith('DATABASE_PASSWORD=') and not l.lstrip().startswith('#'):
        lines[i] = 'DATABASE_PASSWORD=' + pw
        hit = True
        break
if not hit:
    lines.append('DATABASE_PASSWORD=' + pw)
io.open(path, 'w', encoding='utf-8').write('\n'.join(lines))
print(f'  저장했습니다 ({len(pw)}자)')
PY

printf '%s\n' ""
printf '%s\n' "다음:  ./scripts/db-apply    (스키마·시드 적용)"
