#!/bin/sh
# backend/.env 의 접속 정보로 클라우드 DB 상태를 확인한다.
#
# 호스트에 psql 을 설치하지 않는다. Docker 컨테이너 안의 psql 을 쓴다.
# 팀원 PC 마다 psql 유무가 달라 "내 PC 에서는 되는데" 가 생기기 때문이다.
#
# 비밀번호는 절대 출력하지 않는다.

set -e

ENV_FILE="backend/.env"

if [ ! -f "$ENV_FILE" ]; then
  printf '%s\n' "ERROR: $ENV_FILE 이 없습니다." >&2
  printf '%s\n' "" >&2
  printf '%s\n' "  cp backend/.env.example backend/.env" >&2
  printf '%s\n' "" >&2
  printf '%s\n' "그다음 DATABASE_URL · DATABASE_USERNAME · DATABASE_PASSWORD 를 채웁니다." >&2
  printf '%s\n' "절차는 database/README.md 의 'DB 생성 (팀 공용)'." >&2
  exit 1
fi

# .env 를 읽는다. export 없이 값만 뽑는다 (따옴표·공백 방어).
get() {
  sed -n "s/^$1=//p" "$ENV_FILE" | head -1 | sed 's/^["'\'']//; s/["'\'']$//'
}

URL=$(get DATABASE_URL)
USER=$(get DATABASE_USERNAME)
PASS=$(get DATABASE_PASSWORD)

miss=""
[ -z "$URL" ]  && miss="$miss DATABASE_URL"
[ -z "$USER" ] && miss="$miss DATABASE_USERNAME"
[ -z "$PASS" ] && miss="$miss DATABASE_PASSWORD"
if [ -n "$miss" ]; then
  printf '%s\n' "ERROR: $ENV_FILE 에 비어 있는 값이 있습니다:$miss" >&2
  exit 1
fi

case "$URL" in
  jdbc:postgresql://*) ;;
  postgresql://*|postgres://*)
    printf '%s\n' "ERROR: DATABASE_URL 에 'jdbc:' 접두사가 없습니다." >&2
    printf '%s\n' "  Supabase 가 준 문자열을 그대로 넣으면 Spring 이 뜨지 않습니다." >&2
    printf '%s\n' "  jdbc:postgresql://호스트:5432/postgres  형태로 고칩니다." >&2
    exit 1 ;;
  *)
    printf '%s\n' "ERROR: DATABASE_URL 형식을 알 수 없습니다." >&2
    exit 1 ;;
esac

# jdbc:postgresql://host:port/db  →  host:port/db
HOSTPART=${URL#jdbc:postgresql://}
# 쿼리 파라미터가 붙어 있으면 떼어 낸다
HOSTPART=${HOSTPART%%\?*}

if ! command -v docker >/dev/null 2>&1; then
  printf '%s\n' "ERROR: docker 가 필요합니다. Docker Desktop 을 실행하세요." >&2
  exit 1
fi

printf '%s\n' "접속 대상: $HOSTPART"
printf '%s\n' "사용자   : $USER"
printf '%s\n' ""

# 비밀번호는 환경변수로만 넘긴다. 명령줄 인자로 주면 ps 에 보인다.
# 사용자·비밀번호도 URL 이 아니라 옵션으로 넘겨 특수문자 인코딩 문제를 피한다.
HOST=${HOSTPART%%:*}
REST=${HOSTPART#*:}
PORT=${REST%%/*}
DB=${REST#*/}

# 비밀번호는 환경변수로만 넘긴다. 명령줄 인자로 주면 ps 에 보인다.
# 사용자·비밀번호도 URL 이 아니라 옵션으로 넘겨 특수문자 인코딩 문제를 피한다.
run_sql() {
  docker run --rm -i -e PGPASSWORD="$PASS" postgres:17-alpine \
    psql -h "$HOST" -p "$PORT" -U "$USER" -d "$DB" -qtA -v ON_ERROR_STOP=1
}

# ── 1단계: 접속과 스키마 ──────────────────────────────────
run_sql <<'SQL'
SELECT '연결      : OK  (' || current_database() || ' @ ' || split_part(version(), ' ', 2) || ')';
SELECT '테이블    : ' || count(*) || ' 개' FROM information_schema.tables WHERE table_schema = 'public';
SELECT 'CHECK 제약: ' || count(*) || ' 개' FROM pg_constraint WHERE contype = 'c' AND connamespace = 'public'::regnamespace;
SELECT 'FK        : ' || count(*) || ' 개' FROM information_schema.table_constraints WHERE table_schema = 'public' AND constraint_type = 'FOREIGN KEY';
SQL

# ── 2단계: 시드 ──────────────────────────────────────────
# 테이블이 없으면 건너뛴다. 없는 테이블을 조회하면 날 오류가 그대로 보인다.
HAS_TABLES=$(printf '%s' "SELECT CASE WHEN to_regclass('public.trips') IS NULL THEN 'no' ELSE 'yes' END;" | run_sql)

printf '%s\n' ""
if [ "$HAS_TABLES" = "yes" ]; then
  run_sql <<'SQL'
SELECT '시드 데이터';
SELECT '  여행        ' || (SELECT count(*) FROM trips);
SELECT '  체크리스트  ' || (SELECT count(*) FROM checklist_items);
SELECT '  인식 물품   ' || (SELECT count(*) FROM detected_objects);
SELECT '  N:M 연결    ' || (SELECT count(*) FROM item_detections) || ' (물품↔인식) · '
                        || (SELECT count(*) FROM item_rule_checks) || ' (물품↔규정)';
SQL
  TRIPS=$(printf '%s' "SELECT count(*) FROM trips;" | run_sql)
  if [ "$TRIPS" = "0" ]; then
    printf '%s\n' ""
    printf '%s\n' "시드가 비어 있습니다. database/seed.sql 을 SQL Editor 에서 실행하세요."
    printf '%s\n' "3일차 데모에서 빈 화면이 나옵니다."
  fi
else
  printf '%s\n' "아직 테이블이 없습니다. 이것을 실행하세요."
  printf '%s\n' ""
  printf '%s\n' "  ./scripts/db-apply"
  printf '%s\n' ""
  printf '%s\n' "schema.sql 과 seed.sql 을 순서대로 넣습니다. 자세한 것은 database/README.md."
fi
