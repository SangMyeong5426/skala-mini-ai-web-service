#!/bin/sh
# main 브랜치로의 직접 push를 막는다. 두 관문 중 첫 번째다.
#
# GitHub 서버의 브랜치 보호가 두 번째 관문이지만, 그것만으로는 부족하다.
#   - 브랜치 보호는 "Include administrators"가 꺼져 있어 관리자에게 걸리지 않는다.
#     관리자에게는 이 훅이 사실상 유일한 관문이다.
#   - 훅은 push가 GitHub에 닿기 전에 잡으므로 되돌릴 일이 없다.
#
# scripts/setup-git-hooks 를 실행해야 동작한다. clone 직후 한 번 실행한다.
# 자세한 내용은 CLAUDE.md 의 "두 개의 관문".

protected_ref="refs/heads/main"

while read -r local_ref local_sha remote_ref remote_sha
do
  if [ "$remote_ref" = "$protected_ref" ]; then
    printf '%s\n' "ERROR: main 브랜치로 직접 push할 수 없습니다." >&2
    printf '%s\n' "" >&2
    printf '%s\n' "작업 브랜치를 만들고 Pull Request로 merge하세요:" >&2
    printf '%s\n' "  git switch -c feat/short-description" >&2
    exit 1
  fi
done

exit 0
