# 이 파일을 .env 로 복사해서 쓴다. .env 는 커밋되지 않는다.
#   cp .env.example .env
#
# 경고: Vite는 VITE_ 접두사가 붙은 변수를 브라우저 번들에 그대로 넣는다.
#       여기에는 비밀값을 절대 넣지 않는다. API 키는 백엔드에만 둔다.

# 백엔드 API 주소.
# Postman Mock을 쓸 때는 Mock URL로, 로컬 백엔드를 쓸 때는 localhost로 바꾼다.
# 코드는 고치지 않고 이 값만 바꾼다.
#
# 8080은 Spring Boot 기본 포트다. (ADR 0001)
VITE_API_BASE_URL=http://localhost:8080/api

# 백엔드가 붙기 전 화면 개발용. true 면 src/api/mock.ts 가 응답한다.
#
# 기본값은 false 다. true 로 두면 화면이 백엔드에 <b>아예 도달하지 않는다</b> —
# 사진 바이트도 안 올라가고 /api/ai-jobs 도 안 나간다. 시연에서 이 파일을
# 그대로 복사해 쓰다가 데모가 통째로 가짜로 도는 사고를 막으려고 false 로 둔다.
VITE_USE_MOCK=false
