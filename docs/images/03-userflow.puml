@startdot
digraph UserFlow {
  // docs/03-wireframe.md · 2026-09-03 개정. 사진 자동 등록과 추천 채택을 분리한다.
  graph [rankdir=TB, splines=ortho, nodesep=0.5, ranksep=0.55, pad=0.3,
    bgcolor="#FFFFFF", fontname="Apple SD Gothic Neo", fontsize=20,
    label="사용자 흐름 — 로그인 후 사진 자동 등록 · 추천 선택 · 준비 확인", labelloc=t]
  node [shape=box, style="rounded,filled", margin="0.18,0.12",
    color="#8A9A94", fillcolor="#F5F7F6", fontcolor="#14201C",
    fontname="Apple SD Gothic Neo", fontsize=13, penwidth=1]
  edge [color="#606B67", fontcolor="#34403B", fontname="Apple SD Gothic Neo",
    fontsize=11, arrowsize=0.7, penwidth=1]

  entry [label="서비스 접속"]
  session [shape=diamond, style=filled, fillcolor="#F3F1EA", label="로그인 상태가\n유효한가?"]
  auth [label="S-00 로그인·회원가입 /login\n로그인: 아이디 · 비밀번호\n가입: 닉네임 · 아이디 · 비밀번호 · 이메일\n가입 후 로그인 / 실패 시 입력 수정", fillcolor="#E7EDF7", color="#728CAF"]
  signout [label="공통 로그아웃 · 세션 만료\n사용자 데이터 · 사진 · 폴링 정리\n로그인 전 모든 서비스 기능 차단", fillcolor="#E7EDF7", color="#728CAF"]
  entry -> session
  session -> auth [xlabel="아니오"]
  session -> home [xlabel="예"]
  auth -> home [xlabel="로그인 성공"]
  signout -> auth [xlabel="로그인으로", constraint=false]
  home -> signout [xlabel="어느 서비스 화면에서든", style=dashed, constraint=false]

  subgraph cluster_main {
    label="로그인 후 본인 여행 준비 — 내 목록과 추천 후보 분리";
    color="#C7D0C7"; fontcolor="#516059"; fontsize=15; style=rounded; margin=20;

    home [label="S-01 홈\n새 여행 · 과거 기록 · 이어가기\n이어가기: S-03~S-06 마지막 저장 화면 복귀"]
    history [label="S-10 여행 기록 상세\n지난 체크리스트 확인 · 재사용"]
    trip [label="S-02 여행 등록\n일정 · 지역 · 목적 · 이동수단 · 가방 입력\n입력 오류는 값을 유지하고 수정"]
    photo_choice [shape=diamond, style=filled, fillcolor="#F3F1EA", label="사진으로\n시작할까?"]
    photo [label="S-03 짐 사진 등록\n촬영 · 업로드 · 가방 구분\n실패한 사진은 다시 선택"]
    analyze [label="S-04 사진 분석 중\n성공한 사진의 물품을 자동 등록", fillcolor="#DDEEE9", color="#75A89C"]
    review [label="S-04 선택적 사후 수정\n이미 등록된 물품의 이름 · 수량 · 연결 수정\n오인식은 목록에서 삭제 · 수정하지 않아도 진행"]
    prepared [label="내 목록 자동 생성 · 연결\n인식 물품은 승인 없이 챙김 완료로 등록\n낮은 신뢰도도 등록 · 필요하면 사후 수정", fillcolor="#E9F0B6", color="#7D8B3F"]
    recommend [label="S-05 추가 준비물 추천 중\n이미 내 목록에 있는 물품은 제외\n추천 실패 시에도 내 목록 유지", fillcolor="#DDEEE9", color="#75A89C"]
    list [label="S-05 내 체크리스트 · 추가 추천\n위쪽: 내 목록 · 직접 추가 · 실제 완료 체크 · 준비율\n아래쪽: 후보 · 추천 이유 · 필수/권장 · 선택\n미채택 필수 후보 n건 → 확인하기"]
    adopt [label="선택한 추천만 내 목록에 추가\n미완료로 등록 · 중복 추가 방지", fillcolor="#FFF8D5", color="#A08B3C"]
    pack [label="실제로 챙긴 뒤 완료 체크\n준비율 · 예상 무게 갱신", fillcolor="#E9F0B6", color="#7D8B3F"]
    result [label="S-06 검수 결과\n내 목록 준비율 + 별도 사진 확인 상태\n실제 완료 물품의 예상 무게 · 반입 판정\n100%여도 미채택 필수 후보 경고 유지\n추천 미확인 상태는 0건으로 표시하지 않음"]
    details [label="S-07 무게 상세 / S-08 반입 규정 상세\n제외 이유 · 규정 근거 · 추가정보 확인"]
    photo_recheck [label="S-04 사진 재확인\n이미 등록된 물품의 이름/수량 · 연결 수정\n사전 승인 단계 없음\nS-06 복귀 시 준비 상태 · 무게 다시 조회"]
    saved [label="S-06 최종 저장\n준비 결과 저장 완료", fillcolor="#E9F0B6", color="#7D8B3F", penwidth=1.3]

    home -> trip [xlabel="새 여행"]
    home -> history [xlabel="과거 기록"]
    history -> trip [xlabel="다시 사용"]
    trip -> photo_choice [xlabel="저장"]
    photo_choice -> photo [xlabel="사진 등록"]
    photo_choice -> recommend [xlabel="사진 없이 시작"]
    photo -> analyze
    analyze -> prepared [xlabel="인식 완료 · 자동 등록"]
    list -> review [style=dashed, constraint=false]
    review -> list [constraint=false]
    review -> photo [xlabel="재촬영", constraint=false]
    prepared -> recommend
    recommend -> list [xlabel="후보 표시 / 실패 안내"]
    list -> adopt [xlabel="선택한 항목 추가"]
    adopt -> list [constraint=false]
    list -> pack [xlabel="실제로 챙김"]
    list -> photo [xlabel="추가 사진 등록", constraint=false]
    pack -> list [constraint=false]
    list -> result [xlabel="검수하기 · 추천 미채택도 가능", minlen=2]
    result -> list [xlabel="필수 후보 확인 · 준비 수정", constraint=false]
    result -> photo_recheck [xlabel="사진 확인 필요"]
    photo_recheck -> result [xlabel="수정 후 검수 복귀", constraint=false]
    result -> details [xlabel="상세 보기"]
    details -> result [xlabel="돌아가기", constraint=false]
    result -> saved [xlabel="최종 저장"]

    { rank=same; trip; history }
    { rank=same; list; review }
    { rank=same; adopt; pack }
    { rank=same; details; photo_recheck; saved }
  }

  subgraph cluster_chat {
    label="로그인 후 보조 흐름 — 반입 규정 질문";
    color="#E6B9C5"; fontcolor="#9B5669"; fontsize=15; style=rounded; margin=20;
    node [fillcolor="#FAE3E9", color="#D997AA"]
    chat [label="S-09 챗봇\n로그인 필수 · 여행 등록 없이 질문 가능"]
    answer [label="답변 생성 중\n확인된 정보로 규정 조회", fillcolor="#F4CED9"]
    enough [shape=diamond, style=filled, label="판정 정보가\n충분한가?"]
    more [label="추가 질문에 답하기\n모르는 용량 · Wh는 추정하지 않음"]
    chat_result [label="S-09 답변 확인\n판정 · 근거 · 출처"]
    chat_detail [label="S-08 반입 규정 상세\n필요하면 공식 근거 확인"]
    chat -> answer
    answer -> enough
    enough -> more [xlabel="아니오"]
    more -> chat [xlabel="정보 보완", constraint=false]
    enough -> chat_result [xlabel="예"]
    chat_result -> chat_detail [xlabel="상세 보기"]
  }
  home -> chat [xlabel="언제든 열기", style=dashed, color="#C48EA0", fontcolor="#9B5669"]
}
@enddot
