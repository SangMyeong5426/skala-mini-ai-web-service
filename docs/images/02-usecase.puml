@startuml 02-usecase
' AI 여행가방 확인 플랫폼 — Use-Case 다이어그램
' 출처: Notion 「기능 정의」 v2 4절 상세 기능 표
' UC-01~UC-10은 F-01~F-10과 1:1로 대응한다.
' UC-01은 범위 제외 — 회원·비회원을 구분하지 않기로 해 로그인을 두지 않는다.

left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 18
skinparam ranksep 32
skinparam defaultFontName "Apple SD Gothic Neo"
skinparam defaultFontSize 13
skinparam actorStyle awesome

skinparam usecase {
  BackgroundColor #F5F7F6
  BorderColor #8A9A94
  FontColor #14201C
  BackgroundColor<<AI>> #D9EAE6
  BorderColor<<AI>> #0D6455
  FontColor<<AI>> #093B32
  BackgroundColor<<규칙엔진>> #FFF8D5
  BorderColor<<규칙엔진>> #A08B3C
  FontColor<<규칙엔진>> #5C4E17
  BackgroundColor<<제외>> #EFEFEF
  BorderColor<<제외>> #BBBBBB
  FontColor<<제외>> #8C8C8C
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #46524E
}
skinparam rectangle {
  BorderColor #46524E
  FontStyle bold
}

actor "여행자" as TRAVELER

rectangle "AI 여행가방 확인 플랫폼" {
  usecase "UC-01\n회원가입 및 로그인\n<size:11>(범위 제외)</size>" as UC01 <<제외>>
  usecase "UC-02\n여행 등록" as UC02
  usecase "UC-03\n짐 사진 등록" as UC03
  usecase "UC-04\nAI 사진 속 물품 인식" as UC04 <<AI>>
  usecase "UC-05\nAI 맞춤 체크리스트 생성" as UC05 <<AI>>
  usecase "UC-06\n체크리스트 관리" as UC06
  usecase "UC-07\n항공 반입 규정 확인" as UC07 <<규칙엔진>>
  usecase "UC-08\n수하물 확인 챗봇" as UC08 <<AI>>
  usecase "UC-09\n여행 기록 조회 및 재사용" as UC09
  usecase "UC-10\n사진 기반 예상 무게 산정" as UC10 <<AI>>

}

actor "AI 서비스\n(현재 Mock)" as AI
actor "날씨 서비스\n(Open-Meteo)" as WEATHER
actor "공식 규정\n데이터 출처" as RULES

TRAVELER .. UC01
TRAVELER -- UC02
TRAVELER -- UC03
TRAVELER -- UC04
TRAVELER -- UC05
TRAVELER -- UC06
TRAVELER -- UC07
TRAVELER -- UC08
TRAVELER -- UC09
TRAVELER -- UC10

UC04 -- AI
UC05 -- AI
UC07 ..> AI : 물품명 구조화만
UC08 -- AI
UC10 -- AI
UC05 -- WEATHER
UC07 -- RULES
UC08 -- RULES

legend bottom
  |<#D9EAE6>| **AI 확장 지점** — 현재 Mock, 이후 실제 AI 연동 |
  |<#F5F7F6>| 일반 기능 |
  |<#FFF8D5>| **UC-07** — AI는 물품명 구조화, 최종 판정은 규칙 엔진 |
  |<#EFEFEF>| **범위 제외** — 이번 프로젝트에서 만들지 않는다 |
endlegend
@enduml
