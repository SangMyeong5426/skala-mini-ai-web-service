@startuml 02-usecase
' AI 여행가방 확인 플랫폼 — Use-Case 다이어그램
' 출처: Notion 「기능 정의」 v2 4절 상세 기능 표
' UC-01~UC-10은 F-01~F-10과 1:1로 대응한다.

left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 20
skinparam ranksep 25
skinparam defaultFontName "Apple SD Gothic Neo"
skinparam defaultFontSize 13
skinparam actorStyle awesome

skinparam usecase {
  BackgroundColor #F5F7F6
  BorderColor #8A9A94
  FontColor #14201C
  BackgroundColor<<AI>> #D9EAE6
  BorderColor<<AI>> #0D6455
  FontColor<<AI>> #093B32
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #46524E
}
skinparam rectangle {
  BorderColor #46524E
  FontStyle bold
}

actor "여행자" as TRAVELER

rectangle "AI 여행가방 확인 플랫폼" {
  usecase "UC-01\n회원가입 및 로그인" as UC01
  usecase "UC-02\n여행 등록" as UC02
  usecase "UC-03\n짐 사진 등록" as UC03
  usecase "UC-04\nAI 사진 속 물품 인식" as UC04 <<AI>>
  usecase "UC-05\nAI 맞춤 체크리스트 생성" as UC05 <<AI>>
  usecase "UC-06\n체크리스트 관리" as UC06
  usecase "UC-07\n항공 반입 규정 확인" as UC07
  usecase "UC-08\n수하물 확인 챗봇" as UC08 <<AI>>
  usecase "UC-09\n여행 기록 조회 및 재사용" as UC09
  usecase "UC-10\n사진 기반 예상 무게 산정" as UC10 <<AI>>

  ' 기능 관계가 아니라 번호순 세로 배치만 위한 숨김선이다.
  UC10 -[hidden]right- UC09
  UC09 -[hidden]right- UC08
  UC08 -[hidden]right- UC07
  UC07 -[hidden]right- UC06
  UC06 -[hidden]right- UC05
  UC05 -[hidden]right- UC04
  UC04 -[hidden]right- UC03
  UC03 -[hidden]right- UC02
  UC02 -[hidden]right- UC01
}

actor "AI 서비스\n(현재 Mock)" as AI
actor "날씨 서비스\n(Open-Meteo)" as WEATHER
actor "공식 규정\n데이터 출처" as RULES

TRAVELER -- UC01
TRAVELER -- UC02
TRAVELER -- UC03
TRAVELER -- UC04
TRAVELER -- UC05
TRAVELER -- UC06
TRAVELER -- UC07
TRAVELER -- UC08
TRAVELER -- UC09
TRAVELER -- UC10

UC04 -- AI
UC05 -- AI
UC08 -- AI
UC10 -- AI
UC05 -- WEATHER
UC07 -- RULES
UC08 -- RULES

legend bottom
  |<#D9EAE6>| **AI 확장 지점** — 현재 Mock, 이후 실제 AI 연동 |
  |<#F5F7F6>| 일반 기능 |
endlegend
@enduml
