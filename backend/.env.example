# 이 파일을 .env 로 복사해서 쓴다. .env 는 커밋되지 않는다.
#   cp .env.example .env
#
# 실제 값은 저장소가 아니라 팀 채널로 공유한다.

# ── 서버 ──────────────────────────────────────────────────
# 8000은 FastAPI 기본값이다. Spring Boot를 고르면 8080으로 바꾼다.
# 바꾸면 frontend/.env 의 VITE_API_BASE_URL, docs/04-architecture.md,
# docs/06-api-spec.md 의 Base URL도 함께 고친다. (ADR 0001)
PORT=8000

# 프런트엔드 개발 서버 주소. CORS 허용 목록에 넣는다.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── 데이터베이스 ──────────────────────────────────────────
# Supabase 또는 Neon에서 발급받은 PostgreSQL 연결 문자열.
# Supabase: Project Settings → Database → Connection string
# Neon:     Dashboard → Connection Details
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# ── AI (AI-Ready 원칙 4: Security & Config Isolation) ─────
# 지금은 전부 mock이다. 실제 AI를 붙일 때 이 파일만 바꾸고 코드는 고치지 않는다.

# mock | openai | anthropic
AI_PROVIDER=mock

# AI_PROVIDER가 mock이 아닐 때만 필요하다. 절대 커밋하지 않는다.
AI_API_KEY=

AI_MODEL=mock

# 구조화된 JSON을 받아야 하므로 낮게 둔다.
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2048

# Mock 응답 지연(ms). 발표 때 로딩 화면을 보여주고 싶으면 1000~2000으로 둔다.
AI_MOCK_DELAY_MS=0
