# 이 파일을 .env 로 복사해서 쓴다. .env 는 커밋되지 않는다.
#   cp .env.example .env
#
# 실제 값은 저장소가 아니라 팀 채널로 공유한다.
#
# 스택: Java 21 / Spring Boot 4.1.1 (ADR 0001)
#
# .env 자동 주입은 Gradle bootRun에만 적용된다.
# 파일 형식·우선순위·다른 실행 방법: SETUP.md의 "4. 환경 변수"가 정본이다.

# ── 서버 ──────────────────────────────────────────────────
# 8080은 Spring Boot 기본값이다. 바꾸면 frontend/.env 의 VITE_API_BASE_URL,
# docs/04-architecture.md, docs/06-api-spec.md 의 Base URL도 함께 고친다.
PORT=8080

# 프런트엔드 개발 서버 주소. CORS 허용 목록에 넣는다.
# Vite 기본 포트라 React로 바꿔도 5173 그대로다.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── 데이터베이스 ──────────────────────────────────────────
# Supabase 대시보드 상단 Connect → Session pooler (5432)의 JDBC 연결 정보.
# DATABASE_URL 형식: jdbc:postgresql://POOLER_HOST:5432/postgres?sslmode=require
# DATABASE_USERNAME 형식: postgres.PROJECT_REF
#
# 주의: JDBC는 접두사가 jdbc:postgresql:// 다. 대시보드가 주는
#       postgresql://USER:PASSWORD@HOST/DB 를 그대로 붙여넣으면 뜨지 않는다.
#       계정 정보는 URL에서 빼내 아래 두 칸에 따로 넣는다.
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# 서버 인스턴스 하나의 최대 DB 연결 수. 팀 공용 DB 사용량에 맞춰 조정한다.
DB_POOL_SIZE=5

# ── 사진 업로드 ───────────────────────────────────────────
# 짐 사진을 저장할 디렉터리. 저장소에 커밋되지 않는다(.gitignore).
# 클라우드 스토리지가 아니라 로컬에 두는 이유는 데모 때문이다 —
# 인터넷이 끊겨도 시연이 되어야 한다. (docs/checklist.md "데모 사고 방지")
UPLOAD_DIR=./uploads

# 사진 한 장의 최대 크기. 요청 전체 한도는 application.properties의 30MB로 고정이다.
# MAX_UPLOAD_SIZE를 요청 전체 한도보다 크게 잡지 않는다. 여러 장은 합계와 multipart 부가 크기도 고려한다.
MAX_UPLOAD_SIZE=10MB

# ── 날씨 (Open-Meteo) ─────────────────────────────────────
# open-meteo.com — 비상업 용도 무료. **API 키가 필요 없다.**
#
# OpenWeather 를 쓰지 않는 이유: 무료 플랜의 예보가 5일까지고,
# 30일 예보(Climatic Forecast)는 Professional 이상 유료다. 여행 준비는
# 보통 5일보다 일찍 시작하므로 그 구간이 비면 서비스가 성립하지 않는다.
#
# 무료 한도: 600회/분 · 10,000회/일 · 300,000회/월. 우리 규모에서 넉넉하다.
#
# mock | openmeteo
#   mock      외부를 호출하지 않는다. PACKING_LIST 는 날씨 없이 추천하고, 프롬프트가
#             모델에게 "기온·강수 수치를 지어내지 말라"고 명시한다. 출력의
#             weatherSource 는 SEASONAL, weatherAsOf 는 null 이 된다.
#             발표에서 네트워크를 끊고 싶을 때 쓴다.
#   openmeteo 실제 호출. 출발일이 16일 이내면 예보, 넘으면 계절 앙상블이다.
#             실패해도 추천은 나간다 — 날씨는 추천을 거들 뿐이다.
#
# 제공자를 늘리려면 이 값에 이름을 추가하고 클라이언트 구현을 하나 더 두면 된다.
# 다른 코드는 고치지 않는다. (AI_PROVIDER 와 같은 방식)
WEATHER_PROVIDER=openmeteo

# 날씨를 기다리느라 추천이 늦어지면 안 된다. AI 호출보다 훨씬 짧게 잡는다.
WEATHER_TIMEOUT_MS=10000

# ── AI (AI-Ready 원칙 4: Security & Config Isolation) ─────
# 지금은 mock 과 openai 두 가지다. 실제 AI를 붙일 때 이 파일만 바꾸고 코드는 고치지 않는다.
#
# OpenAI 키를 쓸 때 provider 는 openai, base URL 은 api.openai.com 으로 둔다.

# mock | openai
#   mock    외부를 호출하지 않고 src/main/resources/mock/*.json 을 돌려준다.
#           실제 OpenAI 시연 중 네트워크·쿼터 문제가 생겼을 때의 fallback 이다.
#   openai  실제 호출. OpenAiChatApi 가 @ConditionalOnProperty 로 이 값만 본다.
#           BAG_CHECK·PACKING_LIST·tripId가 있는 RULE_CHECK만 실제로 나간다.
#           tripId가 없는 S-09 챗봇과 WEIGHT_ESTIMATE는 Mock을 유지한다.
AI_PROVIDER=mock

# AI_PROVIDER가 mock이 아닐 때만 필요하다. 절대 커밋하지 않는다.
# OpenAI 키는 대개 sk- 로 시작한다.
AI_API_KEY=

# 비전 입력을 받는 모델 이름. mock 이면 실제 호출을 하지 않는다.
# gpt-4o-mini는 이미지 입력·Chat Completions·Structured Outputs를 지원한다.
AI_MODEL=gpt-4o-mini

# 호환 게이트웨이 주소. OpenAI 키는 아래 기본 주소를 사용한다.
# 끝에 슬래시를 붙이지 않는다 - 코드가 /chat/completions 를 이어 붙인다.
AI_BASE_URL=https://api.openai.com/v1

# 구조화된 JSON을 받아야 하므로 낮게 둔다.
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=4096

# 사진 여러 장을 보는 호출은 느리다. 무료 티어는 더 느려서 넉넉히 잡는다.
AI_TIMEOUT_MS=60000

# Mock 응답 지연(ms). 발표 때 로딩 화면을 보여주고 싶으면 1000~2000으로 둔다.
AI_MOCK_DELAY_MS=0

# ── 비전 입력 한도 (BAG_CHECK) ────────────────────────────
# 07 BAG_CHECK 입력 스키마의 maxItems 가 20 이다. 넘는 사진은 failedPhotoIds 로 남아
# 재시도 대상이 된다 — 조용히 버리지 않는다.
AI_VISION_MAX_PHOTOS=20

# 긴 변을 이 픽셀로 줄여 JPEG 로 다시 굽고 보낸다. 원본 10MB 를 20장 보내면 요청이
# 200MB 를 넘고 base64 에서 33% 가 더 붙는다. 토큰 비용도 여기서 정해진다.
AI_VISION_MAX_EDGE_PX=1024

# webp 는 JDK 의 ImageIO 가 읽지 못해 줄이지 못한다. 그때만 원본을 그대로 보내되
# 이 크기를 넘으면 그 사진 한 장을 포기한다. (라이브러리를 새로 넣지 않기 위해서다)
AI_VISION_MAX_RAW_BYTES=4194304
