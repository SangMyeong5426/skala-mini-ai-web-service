# 이 파일을 .env 로 복사해서 쓴다. .env 는 커밋되지 않는다.
#   cp .env.example .env
#
# 실제 값은 저장소가 아니라 팀 채널로 공유한다.
#
# 스택: Java 21 / Spring Boot 4.1.1 (ADR 0001)
#
# Spring Boot 는 .env 를 스스로 읽지 않는다. 이 저장소는 build.gradle 의
# bootRun 태스크가 이 파일을 읽어 환경 변수로 넘긴다. 따로 할 일은 없다.
#   ./gradlew bootRun    ← .env 를 자동으로 읽는다
#
# IDE에서 실행할 때는 실행 구성에 환경 변수를 직접 넣거나, 셸에서
#   set -a; source .env; set +a
# 를 먼저 실행한다.
#
# application.properties 에서는 ${VAR} 로 참조한다. 예: server.port=${PORT}

# ── 서버 ──────────────────────────────────────────────────
# 8080은 Spring Boot 기본값이다. 바꾸면 frontend/.env 의 VITE_API_BASE_URL,
# docs/04-architecture.md, docs/06-api-spec.md 의 Base URL도 함께 고친다.
PORT=8080

# 프런트엔드 개발 서버 주소. CORS 허용 목록에 넣는다.
# Vite 기본 포트라 React로 바꿔도 5173 그대로다.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── 데이터베이스 ──────────────────────────────────────────
# Supabase 또는 Neon에서 발급받은 PostgreSQL 연결 정보.
# Supabase: Project Settings → Database → Connection string
# Neon:     Dashboard → Connection Details
#
# 주의: JDBC는 접두사가 jdbc:postgresql:// 다. 대시보드가 주는
#       postgresql://USER:PASSWORD@HOST/DB 를 그대로 붙여넣으면 뜨지 않는다.
#       계정 정보는 URL에서 빼내 아래 두 칸에 따로 넣는다.
DATABASE_URL=jdbc:postgresql://HOST:5432/DBNAME
DATABASE_USERNAME=
DATABASE_PASSWORD=

# ── 사진 업로드 ───────────────────────────────────────────
# 짐 사진을 저장할 디렉터리. 저장소에 커밋되지 않는다(.gitignore).
# 클라우드 스토리지가 아니라 로컬에 두는 이유는 데모 때문이다 —
# 인터넷이 끊겨도 시연이 되어야 한다. (docs/checklist.md "데모 사고 방지")
UPLOAD_DIR=./uploads

# 사진 한 장의 최대 크기. 요청 전체 한도는 이 값의 3배로 잡혀 있다.
MAX_UPLOAD_SIZE=10MB

# ── 날씨 (OpenWeather) ────────────────────────────────────
# openweathermap.org 무료 플랜. 가입 후 API keys 탭에서 발급받는다.
#
#  ⚠️ 발급한 키는 활성화까지 최대 2시간 걸린다. 미리 받아 둔다.
#  ⚠️ 무료 플랜의 예보는 5일(3시간 간격)까지다. 그보다 먼 여행은 예보가 없다.
#     출발일이 5일을 넘으면 계절 평균으로 answer 하도록 설계한다.
#  ⚠️ 무료 한도: 60회/분, 1,000,000회/월. 우리 규모에서는 넉넉하다.
#
# mock 이면 외부를 호출하지 않고 계절 평균만 돌려준다.
# 발표 데모는 mock 으로 돌리는 것을 권한다 — 네트워크에 묶이지 않는다.
WEATHER_PROVIDER=mock

# 예보:   {BASE_URL}/forecast?lat={lat}&lon={lon}&appid={KEY}
# 현재날씨: {BASE_URL}/weather?lat={lat}&lon={lon}&appid={KEY}
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5

# 절대 커밋하지 않는다. 팀 채널로 공유한다.
WEATHER_API_KEY=

# ── AI (AI-Ready 원칙 4: Security & Config Isolation) ─────
# 지금은 전부 mock이다. 실제 AI를 붙일 때 이 파일만 바꾸고 코드는 고치지 않는다.

# mock | openai | anthropic
AI_PROVIDER=mock

# AI_PROVIDER가 mock이 아닐 때만 필요하다. 절대 커밋하지 않는다.
AI_API_KEY=

AI_MODEL=mock

# 구조화된 JSON을 받아야 하므로 낮게 둔다.
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2048

# Mock 응답 지연(ms). 발표 때 로딩 화면을 보여주고 싶으면 1000~2000으로 둔다.
AI_MOCK_DELAY_MS=0
